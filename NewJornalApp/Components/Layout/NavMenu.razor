@using NewJornalApp.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav



    <div class="bottom">
        <a class="btn-new-entry btn btn-primary" href="/write">+ New Entry</a>
        <button class="logout btn btn-link" @onclick="Logout">Logout</button>
    </div>
</div>

@code {
    private async Task Logout()
    {
        var authElement = (CustomAuthenticationStateProvider)AuthStateProvider;
        authElement.Logout();
        Nav.NavigateTo("/login", true);
    }
}
